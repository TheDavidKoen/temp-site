---
import { Font } from 'astro:assets';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import Intro from '@/components/Intro.astro';
import Seo from '@/components/Seo.astro';
import '@/styles/global.css';
import CursorTrail from '@/components/CursorTrail.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <Font cssVariable="--font-space-grotesk" preload />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains-mono" />

    <Seo title={title} description={description} />

    <!-- Must stay inline and in <head>: it flags the intro as already-seen
         before first paint. Deferring it makes returning visitors flash the
         overlay. Paired with the skip rule in Intro.astro. -->
    <script is:inline>
      (() => {
        try {
          const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (reduced || sessionStorage.getItem('intro') === 'seen') {
            document.documentElement.dataset.intro = 'skip';
          } else {
            sessionStorage.setItem('intro', 'seen');
          }
        } catch {
          document.documentElement.dataset.intro = 'skip';
        }
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <Intro />

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-100 focus:bg-ink focus:px-4 focus:py-2 focus:font-mono focus:text-xs focus:tracking-label focus:text-surface focus:uppercase"
    >
      Skip to content
    </a>

    <Header />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />
    
    <CursorTrail />
  </body>
</html>
