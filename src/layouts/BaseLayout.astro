---
import { Font } from 'astro:assets';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import Intro from '@/components/Intro.astro';
import Seo from '@/components/Seo.astro';
import '@/styles/global.css';
import CursorTrail from '@/components/CursorTrail.astro';
import Dock from '@/components/Dock.astro';
import MissedMix from '@/components/MissedMix.astro';
import Stack from '@/components/Stack.astro';
import Terminal from '@/components/Terminal.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <Font cssVariable="--font-space-grotesk" preload />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains-mono" />
    <Font cssVariable="--font-figtree" />

    <Seo title={title} description={description} />

    <!-- Must stay inline and in <head>: all three flags are read before first paint. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.dataset.dock = 'closed';

        // Light unless the visitor has chosen dark; the system setting is ignored.
        let dark = false;
        try {
          dark = localStorage.getItem('theme') === 'dark';
        } catch {
          // Storage can be refused in private browsing; stay light.
        }
        root.dataset.theme = dark ? 'dark' : 'light';

        // Literal, because the stylesheet may not have parsed yet. Matches --color-surface.
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', dark ? '#101a1c' : '#f5f5f5');

        try {
          const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (reduced || sessionStorage.getItem('intro') === 'seen') {
            document.documentElement.dataset.intro = 'skip';
          } else {
            sessionStorage.setItem('intro', 'seen');
          }
        } catch {
          document.documentElement.dataset.intro = 'skip';
        }
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <Intro />

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-100 focus:bg-ink focus:px-4 focus:py-2 focus:font-mono focus:text-xs focus:tracking-label focus:text-surface focus:uppercase"
    >
      Skip to content
    </a>

    <Header />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />

    <CursorTrail />
    <Terminal />
    <Stack />
    <MissedMix />
    <Dock />
    <ThemeToggle />
  </body>
</html>
