---
import {
  ABOUT,
  CONTACT,
  CONTACT_MAILTO,
  EXPERIENCE_NARRATIVE,
  INTRO,
  MARQUEE_PHRASES,
  SITE,
  SKILL_GROUPS,
  WORK,
} from '@shared/content';
import Button from '@/components/Button.astro';
import ChaseScene from '@/components/ChaseScene.astro';
import Container from '@/components/Container.astro';
import GhostScene from '@/components/GhostScene.astro';
import Hero from '@/components/Hero.astro';
import Marquee from '@/components/Marquee.astro';
import PinnedText from '@/components/PinnedText.astro';
import QueryMark from '@/components/QueryMark.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';
import Section from '@/components/Section.astro';
import SectionLead from '@/components/SectionLead.astro';
import ToolRail from '@/components/ToolRail.astro';
import Wordmark from '@/components/Wordmark.astro';
import Work from '@/components/Work.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout>
  <Hero />

  <ToolRail />

  <Container as="section" class="intro py-[var(--section-space)]">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-center lg:gap-16">
      <div>
        <p class="mb-6 label">{SITE.tagline}</p>

        <h1 class="max-w-[14ch] font-display text-display font-bold text-ink">
          <Wordmark />
        </h1>

        <p class="mt-8 max-w-prose text-lg text-ink-muted">{INTRO.lede}</p>

        <div class="mt-10 flex flex-wrap gap-4">
          <Button href={INTRO.primary.href}>{INTRO.primary.label}</Button>
          <Button href={INTRO.secondary.href} variant="outline">{INTRO.secondary.label}</Button>
        </div>
      </div>

      <ChaseScene />
    </div>
  </Container>

  <Section id="about" label="About">
    <div class="grid gap-10 lg:grid-cols-[2fr_1fr] lg:gap-16">
      <SectionLead lead={ABOUT.lead} body={ABOUT.body} />

      <dl class="space-y-6 border-l-2 border-signal pl-5 lg:pl-10">
        {
          ABOUT.facts.map(({ label, value }) => (
            <div>
              <dt class="label">{label}</dt>
              <dd class="mt-1 font-display text-lg text-ink">{value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </Section>

  <Marquee phrases={MARQUEE_PHRASES} />

  <Section id="skills" label="Skills">
    <div class="grid grid-cols-2 gap-6 sm:gap-10 lg:grid-cols-4">
      {
        SKILL_GROUPS.map(({ title, items }) => (
          <div class="border-l-2 border-signal pl-5">
            <h3 class="font-display text-xl font-medium text-ink">{title}</h3>
            <ul class="mt-4 list-disc space-y-2 pl-4 marker:text-signal">
              {items.map((item) => (
                <li class="text-sm text-ink-muted">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Section>

  <PinnedText id="experience" label="Experience">
    {
      EXPERIENCE_NARRATIVE.map((paragraph, i) => (
        <ScrollReveal
          text={paragraph}
          index={i - 1}
          count={EXPERIENCE_NARRATIVE.length - 1}
          animate={i > 0}
        />
      ))
    }
  </PinnedText>

  <Section id="work" label="Work" class="lg:text-center">
    <SectionLead lead={WORK.lead} body={WORK.body} centred />
    <div class="mt-12">
      <Work />
    </div>
  </Section>

  <Section id="contact" label="Contact">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-center lg:gap-16">
      <div class="max-w-prose space-y-8">
        <p class="font-display text-3xl font-medium text-ink">
          {CONTACT.heading}<QueryMark />
        </p>
        <p class="text-ink-muted">{CONTACT.body}</p>
        <Button href={CONTACT_MAILTO}>{CONTACT.cta}</Button>
      </div>

      <GhostScene />
    </div>
  </Section>
</BaseLayout>
