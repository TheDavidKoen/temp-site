<button
  class="launcher launcher--toggle"
  style="--launcher-order: 0; --launcher-mark: url('/plus.svg')"
  data-dock-toggle
  type="button"
  aria-expanded="false"
  aria-label="Explore more"
>
  <span class="launcher__mark" aria-hidden="true"></span>
  <span class="tip launcher__tip" aria-hidden="true" data-dock-tip>Explore more.</span>
</button>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-dock-toggle]');
  const tip = document.querySelector<HTMLElement>('[data-dock-tip]');
  const stowable = [...document.querySelectorAll<HTMLElement>('.launcher--stowable')];

  if (toggle && stowable.length) {
    const isOpen = (): boolean => toggle.getAttribute('aria-expanded') === 'true';

    /* inert, not just pointer-events, or stowed bubbles stay reachable by keyboard
       while invisible. */
    const setOpen = (open: boolean): void => {
      document.documentElement.dataset.dock = open ? 'open' : 'closed';
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close' : 'Explore more');
      if (tip) tip.textContent = open ? 'Close.' : 'Explore more.';
      for (const bubble of stowable) bubble.inert = !open;
    };

    setOpen(false);

    toggle.addEventListener('click', () => {
      setOpen(!isOpen());
    });

    /* click rather than pointerdown, so a touch that turns into a scroll does not
       collapse the dock. */
    document.addEventListener('click', (event) => {
      if (!isOpen()) return;

      if (document.querySelector('dialog[open]')) return;

      /* The theme switch shares the launcher look but is not part of the dock. */
      const target = event.target;
      const inDock = target instanceof Element && target.closest('.launcher--toggle, .launcher--stowable');
      if (!inDock) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  .launcher--toggle .launcher__mark {
    transition: transform 0.4s var(--ease-spring);
  }

  /* 135, not 45, so opening and closing spin in different directions. */
  .launcher--toggle[aria-expanded='true'] .launcher__mark {
    transform: rotate(135deg);
  }
</style>
