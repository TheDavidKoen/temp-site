---
import { TOOLS } from '@shared/content';
---

<section class="rail" data-tool-scroller aria-label="Tools I work with">
  <div class="rail__track" data-tool-rail>
    {
      [0, 1].map((group) => (
        <ul class="rail__list" aria-hidden={group === 1 ? 'true' : undefined}>
          {TOOLS.map((tool, i) => (
            <li class="rail__item" style={`--i: ${i}`}>
              <span
                class="rail__mark"
                style={`--tool-mark: url('${tool.logo}')`}
                aria-hidden="true"
              />
              {/* Hidden by opacity, not sr-only: one element is the label and the accessible name. */}
              <span class="tip rail__tip">{tool.name}</span>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</section>

<script>
  import { onceVisible } from '@/scripts/lazy';

  const scroller = document.querySelector<HTMLElement>('[data-tool-scroller]');
  const track = document.querySelector<HTMLElement>('[data-tool-rail]');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sliding = matchMedia('(width < 40rem)').matches;

  /* Visible by default and hidden by script, so the row survives without JavaScript. */
  if (track && !still && !sliding) {
    track.dataset.armed = 'true';
    onceVisible(
      track,
      () => {
        track.dataset.shown = 'true';
      },
      { threshold: 0.35 },
    );
  }

  /* scrollLeft rather than a transform, so the drift and a dragging finger cannot
     fight. The duplicate group makes the wrap seamless. */
  if (scroller && track && sliding && !still) {
    const SPEED = 0.35;
    let held = false;
    let visible = true;
    let frame = 0;

    const step = (): void => {
      frame = requestAnimationFrame(step);
      if (held || !visible) return;

      scroller.scrollLeft += SPEED;
      const half = track.scrollWidth / 2;
      if (scroller.scrollLeft >= half) scroller.scrollLeft -= half;
    };

    const hold = (): void => {
      held = true;
    };
    const release = (): void => {
      held = false;
    };

    scroller.addEventListener('pointerdown', hold, { passive: true });
    scroller.addEventListener('pointerup', release, { passive: true });
    scroller.addEventListener('pointercancel', release, { passive: true });
    scroller.addEventListener('pointerleave', release, { passive: true });

    new IntersectionObserver((entries) => {
      visible = entries.some((entry) => entry.isIntersecting);
    }).observe(scroller);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) cancelAnimationFrame(frame);
      else frame = requestAnimationFrame(step);
    });

    frame = requestAnimationFrame(step);
  }
</script>

<style>
  /* Pulled up into the intro's bottom padding so it reads as part of that block.
     overflow only hides the slider's duplicate group; above the slider breakpoint it
     would clip the tooltips. */
  .rail {
    margin-top: calc(var(--section-space) * -0.7);
    padding-block: 2.25rem;
    overflow: hidden;
  }

  @media (width >= 40rem) {
    .rail {
      overflow: visible;
    }
  }

  @media (width < 40rem) {
    .rail {
      padding-block: 1.25rem;
      overflow-x: auto;

      /* :root's smooth scrolling would animate every scrollLeft write and stall the
         drift. */
      scroll-behavior: auto;

      overscroll-behavior-x: contain;
      scrollbar-width: none;
    }

    .rail::-webkit-scrollbar {
      display: none;
    }
  }

  .rail__track {
    display: flex;
    width: max-content;
  }

  .rail__list {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    margin: 0;
    padding: 0 1.25rem 0 0;
    list-style: none;
  }

  @media (width >= 40rem) {
    .rail__track {
      width: auto;
    }

    .rail__list:nth-child(2) {
      display: none;
    }

    .rail__list {
      flex: 1;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.75rem 2.5rem;
      max-width: var(--container-wide);
      margin-inline: auto;
      padding: 0 1.5rem;
    }
  }

  @media (width >= 64rem) {
    .rail__list {
      flex-wrap: nowrap;
      justify-content: space-between;
      gap: 0;
      padding-inline: 3rem;
    }
  }

  .rail__item {
    position: relative;
    display: grid;
    place-items: center;
  }

  .rail__item:hover {
    z-index: 2;
  }

  .rail__track[data-armed='true'] .rail__item {
    opacity: 0;
    transform: translateY(0.75rem);
    transition:
      opacity 0.65s linear,
      transform 0.85s var(--ease-out-quint);
    transition-delay: calc(var(--i) * 110ms);
  }

  .rail__track[data-armed='true'][data-shown='true'] .rail__item {
    opacity: 1;
    transform: translateY(0);
  }

  .rail__mark {
    display: block;
    width: 1.75rem;
    height: 1.75rem;
    background-color: color-mix(in srgb, var(--color-ink-muted) 55%, transparent);
    mask-image: var(--tool-mark);
    mask-repeat: no-repeat;
    mask-position: center;
    mask-size: contain;
    transition: background-color 0.28s linear;
  }

  .rail__item:hover .rail__mark {
    background-color: var(--color-ink);
  }

  .rail__tip {
    bottom: calc(100% + 0.6rem);
    left: 50%;
    transform: translateX(-50%) translateY(0.3rem);
  }

  .rail__tip::after {
    top: 100%;
    left: 50%;
    border-top-color: var(--color-ink);
    transform: translateX(-50%);
  }

  /* Hover labels only where a real pointer exists, so they never stick after a tap. */
  @media (width >= 40rem) {
    .rail__item:hover .rail__tip {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
  }
</style>
