---
const MISSED_MIX = 'https://missed-mix.pages.dev/';
---

<a
  class="launcher launcher--stowable"
  style="--launcher-order: 3"
  href={MISSED_MIX}
  target="_blank"
  rel="noopener"
  aria-describedby="missedmix-tip"
>
  <span class="launcher__word" aria-hidden="true">MM</span>
  <span class="sr-only">Missed Mix, opens in a new tab</span>
  <span class="launcher__tip" id="missedmix-tip" role="tooltip">Missed Mix. Social, music app.</span>
</a>

<style>
  .launcher__word {
    font-family: var(--font-figtree);
    font-size: 0.98rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--color-signal);
  }
</style>
