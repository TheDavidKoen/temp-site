---
const GLYPHS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/#$%&*<>[]{}';
const FIELD = 1400;

/* Seeded rather than random so the first paint is identical on every build. */
const seed = (i: number): string =>
  GLYPHS[Math.floor(Math.abs(Math.sin(i * 91.7)) * GLYPHS.length)];
---

<section class="hero" data-hero>
  <div class="hero__stage">
    <div class="hero__glyphs" aria-hidden="true">
      {Array.from({ length: FIELD }, (_, i) => <span class="hero__glyph">{seed(i)}</span>)}
    </div>

    <span class="hero__welcome" aria-hidden="true">Welcome</span>

    <canvas class="hero__canvas" data-hero-canvas aria-hidden="true"></canvas>

    <span class="hero__cue" aria-hidden="true">Scroll down</span>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  const nav = navigator as Navigator & { deviceMemory?: number };

  /* Matches the media query that hides .hero below 40rem, without this the
     127KB scene would still download for a section nobody can see. */
  const wanted =
    !matchMedia('(prefers-reduced-motion: reduce)').matches &&
    !matchMedia('(width < 40rem)').matches;
  const capable = (nav.deviceMemory ?? 8) >= 4 && (nav.hardwareConcurrency ?? 8) >= 4;

  const glyphs = [...document.querySelectorAll<HTMLElement>('.hero__glyph')];
  const CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/#$%&*<>[]{}';

  if (glyphs.length && wanted) {
    let lastY = window.scrollY;

    // Driven by scroll distance rather than a timer, so the field is still
    // when the page is, and churns while you move.
    window.addEventListener(
      'scroll',
      () => {
        if (Math.abs(window.scrollY - lastY) < 8) return;
        lastY = window.scrollY;
        for (let n = 0; n < 220; n++) {
          const glyph = glyphs[(Math.random() * glyphs.length) | 0];
          glyph.textContent = CHARS[(Math.random() * CHARS.length) | 0];
        }
      },
      { passive: true },
    );
  }

  if (section && canvas && wanted && capable) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        import('@/scripts/hero-scene').then(({ initHeroScene }) => {
          initHeroScene(canvas, section);
        });
      },
      { rootMargin: '200px' },
    );
    observer.observe(section);
  }
</script>

<style>
  /* Scroll distance is the animation's timeline: the scene finishes exactly
     when the stage unpins. Changing this height changes the pacing. */
  .hero {
    height: 300vh;

    /* Declared here, not in the media block below: the welcome drift consumes
       --hero from a rule that only applies on desktop. */
    view-timeline: --hero block;
  }

  @media (width < 40rem) {
    .hero {
      display: none;
    }
  }

  .hero__stage {
    position: sticky;
    top: 0;
    display: grid;
    grid-template: 1fr / 1fr;
    height: 100dvh;
    overflow: clip;
    contain: paint;
  }

  /* Tiles edge to edge rather than clustering: auto-fill columns with more
     cells than any viewport needs, and the overflow clipped. */
  .hero__glyphs {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(2.6rem, 1fr));
    align-content: start;
    justify-items: center;
    row-gap: 1.6rem;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1;
    color: color-mix(in srgb, var(--color-ink-muted) 30%, transparent);
    user-select: none;
  }

  .hero__welcome {
    grid-area: 1 / 1;
    place-self: center;
    font-family: var(--font-display);
    font-size: clamp(5rem, 20vw, 18rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    white-space: nowrap;
    color: color-mix(in srgb, var(--color-ink) 7%, transparent);
    user-select: none;
  }

  /* Drifts against the hero's own view timeline, so it tracks the same scroll
     that drives the chase rather than the document. */
  @supports (animation-timeline: view()) {
    .hero__welcome {
      animation: welcome-drift linear both;
      animation-timeline: --hero;
      animation-range: contain 0% contain 100%;
    }
  }

  @keyframes welcome-drift {
    from {
      transform: translateX(28%);
    }
    to {
      transform: translateX(-28%);
    }
  }

  .hero__canvas {
    grid-area: 1 / 1;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__cue {
    grid-area: 1 / 1;
    z-index: 1;
    place-self: center;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-align: center;
    color: var(--color-ink-muted);
  }

  .hero__cue::after {
    content: '';
    display: block;
    width: 1px;
    height: 2.5rem;
    margin: 0.75rem auto 0;
    background: linear-gradient(to bottom, var(--color-ink-muted), transparent);
  }

  @media (height < 44rem) {
    .hero__cue {
      display: none;
    }
  }

  @supports (animation-timeline: scroll()) {
    .hero__cue {
      animation: cue-fade linear both;
      animation-timeline: scroll(root);
      animation-range: 0 20vh;
    }
  }

  @keyframes cue-fade {
    to {
      opacity: 0;
    }
  }
</style>