---
import { HERO_QUOTE } from '@shared/content';

const QUOTE_WORDS = HERO_QUOTE.text.split(' ');

const GLYPHS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/#$%&*<>[]{}';
const FIELD = 1400;

const seed = (i: number): string =>
  GLYPHS[Math.floor(Math.abs(Math.sin(i * 91.7)) * GLYPHS.length)];
---

<section class="hero" data-hero>
  <div class="hero__stage">
    <div class="hero__glyphs" aria-hidden="true">
      {Array.from({ length: FIELD }, (_, i) => <span class="hero__glyph">{seed(i)}</span>)}
    </div>

    <div class="hero__centre">
      <span class="hero__welcome" aria-hidden="true">Welcome</span>

      <figure class="hero__quote">
        <blockquote class="hero__quote-text" aria-hidden="true">
          {
            QUOTE_WORDS.map((word, i) => (
              <span
                class="hero__quote-word"
                style={`--d: ${(i / (QUOTE_WORDS.length - 1)).toFixed(4)}`}
              >
                {word}
              </span>
            ))
          }
        </blockquote>
        <figcaption class="label hero__quote-by" aria-hidden="true">
          {HERO_QUOTE.attribution}
        </figcaption>
        <span class="sr-only">{HERO_QUOTE.text} {HERO_QUOTE.attribution}</span>
      </figure>
    </div>

  </div>
</section>

<script>
  const glyphs = [...document.querySelectorAll<HTMLElement>('.hero__glyph')];
  const CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/#$%&*<>[]{}';

  const wanted =
    !matchMedia('(prefers-reduced-motion: reduce)').matches &&
    !matchMedia('(width < 40rem)').matches;

  if (glyphs.length && wanted) {
    let lastY = window.scrollY;

    /* Coalesced to one burst per frame. The listener itself is cheap; the 220
       writes are not, and scroll can fire several times between paints. */
    let queued = false;
    window.addEventListener(
      'scroll',
      () => {
        if (queued || Math.abs(window.scrollY - lastY) < 8) return;
        lastY = window.scrollY;
        queued = true;
        requestAnimationFrame(() => {
          for (let n = 0; n < 220; n++) {
            const glyph = glyphs[(Math.random() * glyphs.length) | 0];
            glyph.textContent = CHARS[(Math.random() * CHARS.length) | 0];
          }
          queued = false;
        });
      },
      { passive: true },
    );
  }
</script>

<style>
  /* Declares --hero, which the header reveal in Header.astro also animates
     against. Renaming it here silently disables that. */
  .hero {
    height: 300vh;
    view-timeline: --hero block;
  }

  @media (width < 40rem) {
    .hero {
      display: none;
    }
  }

  .hero__stage {
    position: sticky;
    top: 0;
    display: grid;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    height: 100dvh;
    overflow: clip;
    contain: paint;
  }

  .hero__glyphs {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(2.6rem, 1fr));
    align-content: start;
    justify-items: center;
    row-gap: 1.6rem;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1;
    color: color-mix(in srgb, var(--color-ink-muted) 30%, transparent);
    user-select: none;
  }

  /* Wordmark and quote share one column so the gap between them holds at any
     viewport, rather than each being centred and hoping they clear. */
  .hero__centre {
    grid-area: 1 / 1;
    place-self: center;
    display: grid;
    justify-items: center;
    gap: clamp(1.5rem, 4vh, 3.5rem);
    width: 100%;
  }

  .hero__welcome {
    font-family: var(--font-display);
    font-size: clamp(5rem, 20vw, 18rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    white-space: nowrap;
    color: var(--color-ink-muted);
    user-select: none;
  }

  /* Guarded, because without the stroke a transparent fill leaves the word
     invisible rather than outlined. */
  @supports (-webkit-text-stroke: 1px currentcolor) {
    .hero__welcome {
      color: transparent;
      -webkit-text-stroke: 2px var(--color-ink-muted);
    }
  }

  @supports (animation-timeline: view()) {
    .hero__welcome {
      animation: welcome-drift linear both;
      animation-timeline: --hero;
      animation-range: contain 0% contain 100%;
    }
  }

  @keyframes welcome-drift {
    from {
      transform: translateX(28%);
    }
    to {
      transform: translateX(-28%);
    }
  }

  .hero__quote {
    max-width: 34rem;
    margin: 0;
    padding-inline: 1.5rem;
    text-align: center;
  }

  .hero__quote-text {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.45;
    text-wrap: balance;
    color: var(--color-ink-muted);
  }

  .hero__quote-word {
    display: inline-block;
    margin-right: 0.28em;
  }

  /* Carried by the first and last word rather than the blockquote, so the marks
     fade in with the line instead of sitting there alone before it arrives.
     Escapes rather than literal glyphs, so the source stays ASCII and a tool
     rewriting this file in the wrong encoding cannot mangle them. */
  .hero__quote-word:first-child::before {
    content: "\201C";
  }

  .hero__quote-word:last-child::after {
    content: "\201D";
  }

  .hero__quote-by {
    display: block;
    margin-top: 0.9rem;
    color: var(--color-ink-muted);
  }

  /* Each word carries its own slice of the hero scroll, so the line assembles
     left to right as the reader moves rather than arriving whole. */
  @supports (animation-timeline: view()) {
    .hero__quote-word {
      animation: quote-word linear both;
      animation-timeline: --hero;
      animation-range: contain calc(8% + var(--d) * 30%) contain calc(22% + var(--d) * 30%);
    }

    .hero__quote-by {
      animation: quote-word linear both;
      animation-timeline: --hero;
      animation-range: contain 42% contain 56%;
    }
  }

  @keyframes quote-word {
    from {
      opacity: 0;
      transform: translateY(0.9em);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__quote-word,
    .hero__quote-by {
      animation: none;
    }
  }

  @media (height < 44rem) {
    .hero__quote {
      display: none;
    }
  }

</style>