---
import Container from '@/components/Container.astro';
---

<section class="hero" data-hero>
  <div class="hero__stage">
    <canvas class="hero__canvas" data-hero-canvas aria-hidden="true"></canvas>

    <Container class="hero__content">
      <slot />
    </Container>

    <span class="hero__cue" aria-hidden="true">Scroll down</span>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  const nav = navigator as Navigator & { deviceMemory?: number };

  const wanted = !matchMedia('(prefers-reduced-motion: reduce)').matches;
  const capable = (nav.deviceMemory ?? 8) >= 4 && (nav.hardwareConcurrency ?? 8) >= 4;

  if (section && canvas && wanted && capable) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        import('@/scripts/hero-scene').then(({ initHeroScene }) => {
          initHeroScene(canvas, section);
        });
      },
      { rootMargin: '200px' },
    );
    observer.observe(section);
  }
</script>

<style>
  /* Scroll distance is the animation's timeline: the scene finishes exactly
     when the stage unpins. Changing this height changes the pacing. */
  .hero {
    height: 300vh;
  }

  @media (width < 40rem) {
    .hero {
      height: 220vh;
    }
  }

  .hero__stage {
    position: sticky;
    top: 0;
    display: grid;
    grid-template: 1fr / 1fr;
    height: 100dvh;
    overflow: clip;
    contain: paint;
  }

  .hero__canvas {
    grid-area: 1 / 1;
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__content {
    grid-area: 1 / 1;
    z-index: 1;
    align-self: start;
    padding-top: 7rem;
  }

  /* Below 40rem the stage shows the scene alone. This hides the slotted h1
     from mobile rendering, which is what Google indexes — see the note in
     docs before removing the copy from the DOM as well. */
  @media (width < 40rem) {
    .hero__content {
      display: none;
    }
  }

  .hero__cue {
    grid-area: 1 / 1;
    z-index: 1;
    place-self: center;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-align: center;
    color: var(--color-ink-muted);
  }

  .hero__cue::after {
    content: '';
    display: block;
    width: 1px;
    height: 2.5rem;
    margin: 0.75rem auto 0;
    background: linear-gradient(to bottom, var(--color-ink-muted), transparent);
  }

  @media (height < 44rem) {
    .hero__cue {
      display: none;
    }
  }

  @supports (animation-timeline: scroll()) {
    .hero__cue {
      animation: cue-fade linear both;
      animation-timeline: scroll(root);
      animation-range: 0 20vh;
    }
  }

  @keyframes cue-fade {
    to {
      opacity: 0;
    }
  }
</style>