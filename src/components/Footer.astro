---
import Container from '@/components/Container.astro';
import { SITE, SOCIAL_LINKS } from '@/consts';

const year = new Date().getFullYear();
---

<footer class="border-t border-surface-muted bg-surface-tint">
  <Container class="flex flex-col gap-8 py-12 md:flex-row md:items-end md:justify-between">
    <div class="space-y-2">
      <p class="font-display text-xl font-bold text-ink">
        {SITE.name}<span class="text-signal">.</span>
      </p>
      <p class="max-w-narrow text-sm text-ink-muted">
        Digital Project Manager &amp; Web Developer &mdash; {SITE.location}
      </p>
    </div>

    <nav aria-label="Social">
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {
          SOCIAL_LINKS.map(({ href, label }) => (
            <li>
              <a
                href={href}
                rel="noopener noreferrer"
                target="_blank"
                class="font-mono text-xs uppercase tracking-label text-ink-muted transition-colors hover:text-signal-text"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </Container>

  <div class="border-t border-surface-muted">
    <Container class="py-5">
      <p class="font-mono text-xs text-ink-muted">&copy; {year} {SITE.name}</p>
    </Container>
  </div>
</footer>
