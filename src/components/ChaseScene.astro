<div class="chase" data-chase>
  <canvas class="chase__canvas" data-chase-canvas aria-hidden="true"></canvas>
</div>

<script>
  import { canRenderScene, onceVisible } from '@/scripts/lazy';

  const stage = document.querySelector<HTMLElement>('[data-chase]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-chase-canvas]');

  if (stage && canvas && canRenderScene()) {
    onceVisible(
      stage,
      () => {
        import('@/scripts/chase-scene').then(({ initChaseScene }) => {
          initChaseScene(canvas, stage);
        });
      },
      { rootMargin: '200px' },
    );
  }
</script>

<style>
  .chase {
    display: none;
  }

  @media (width >= 64rem) {
    .chase {
      display: block;
      width: 100%;
      max-width: 22rem;
      margin-inline: auto;
      aspect-ratio: 3 / 4;
    }
  }

  .chase__canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
