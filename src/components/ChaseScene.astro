<div class="chase" data-chase>
  <canvas class="chase__canvas" data-chase-canvas aria-hidden="true"></canvas>
</div>

<script>
  const stage = document.querySelector<HTMLElement>('[data-chase]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-chase-canvas]');
  const nav = navigator as Navigator & { deviceMemory?: number };

  /* Mirrors the breakpoint that hides the panel. Without the width check the
     127 KB scene would download for an element nobody can see. */
  const wanted =
    !matchMedia('(prefers-reduced-motion: reduce)').matches &&
    matchMedia('(width >= 64rem)').matches;
  const capable = (nav.deviceMemory ?? 8) >= 4 && (nav.hardwareConcurrency ?? 8) >= 4;

  if (stage && canvas && wanted && capable) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        import('@/scripts/chase-scene').then(({ initChaseScene }) => {
          initChaseScene(canvas, stage);
        });
      },
      { rootMargin: '200px' },
    );

    observer.observe(stage);
  }
</script>

<style>
  .chase {
    display: none;
  }

  @media (width >= 64rem) {
    .chase {
      display: block;
      width: 100%;
      max-width: 22rem;
      margin-inline: auto;
      aspect-ratio: 3 / 4;
    }
  }

  .chase__canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
