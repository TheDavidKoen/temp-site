---
import Container from '@/components/Container.astro';

interface Props {
  id: string;
  label: string;
  class?: string;
}

const { id, label, class: className } = Astro.props;
---

<section id={id} class:list={['border-t border-surface-muted py-[var(--section-space)]', className]}>
  <Container>
    <h2 class="label">{label}</h2>
    <div class="mt-10">
      <slot />
    </div>
  </Container>
</section>
