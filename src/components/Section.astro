---
import Container from '@/components/Container.astro';

interface Props {
  id: string;
  label: string;
  class?: string;
}

const { id, label, class: className } = Astro.props;

/* With an aside the section splits on desktop and pins the aside. top-24 matches the
   anchor offset in global.css. */
const split = Astro.slots.has('aside');
---

<section id={id} class:list={['border-t border-surface-muted py-[var(--section-space)]', className]}>
  <Container>
    {
      split ? (
        <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.75fr)] lg:gap-16">
          <div class="lg:sticky lg:top-24 lg:self-start">
            <h2 class="label">{label}</h2>
            <div class="mt-10">
              <slot name="aside" />
            </div>
          </div>
          <div>
            <slot />
          </div>
        </div>
      ) : (
        <Fragment>
          <h2 class="label">{label}</h2>
          <div class="mt-10">
            <slot />
          </div>
        </Fragment>
      )
    }
  </Container>
</section>
