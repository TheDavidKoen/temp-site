---
const DOTS = 12;

const dots = Array.from({ length: DOTS }, (_, i) => ({
  size: (9 - i * 0.55).toFixed(2),
  fade: (1 - (i / DOTS) * 0.72).toFixed(2),
}));
---

<div class="trail" aria-hidden="true">
  {dots.map(({ size, fade }) => <span class="trail__dot" style={`--size:${size}px;--fade:${fade}`} />)}
</div>

<script>
  const trail = document.querySelector<HTMLElement>('.trail');
  const dots = [...document.querySelectorAll<HTMLElement>('.trail__dot')];

  const zones = [
    document.querySelector<HTMLElement>('[data-hero]'),
    document.querySelector<HTMLElement>('header'),
    document.querySelector<HTMLElement>('footer'),
  ].filter((zone): zone is HTMLElement => zone !== null);

  const CLICKABLE = 'a, button, input, select, textarea, summary, label, [role="button"]';

  const wanted =
    !matchMedia('(prefers-reduced-motion: reduce)').matches &&
    matchMedia('(width >= 64rem)').matches &&
    matchMedia('(pointer: fine)').matches;

  if (trail && dots.length && wanted) {
    const pointer = { x: window.innerWidth / 2, y: window.innerHeight / 2 };
    const positions = dots.map(() => ({ ...pointer }));

    let frame = 0;
    let running = false;

    const tick = (): void => {
      let leadX = pointer.x;
      let leadY = pointer.y;
      let drift = 0;

      for (let i = 0; i < positions.length; i++) {
        const position = positions[i];
        const dx = leadX - position.x;
        const dy = leadY - position.y;

        position.x += dx * 0.34;
        position.y += dy * 0.34;
        drift = Math.max(drift, Math.abs(dx), Math.abs(dy));

        dots[i].style.transform = `translate3d(${position.x}px, ${position.y}px, 0)`;
        leadX = position.x;
        leadY = position.y;
      }

      if (drift < 0.2) {
        running = false;
        return;
      }

      frame = requestAnimationFrame(tick);
    };

    const start = (): void => {
      if (running) return;
      running = true;
      frame = requestAnimationFrame(tick);
    };

    const stop = (): void => {
      running = false;
      cancelAnimationFrame(frame);
    };

    window.addEventListener(
      'pointermove',
      (event) => {
        pointer.x = event.clientX;
        pointer.y = event.clientY;

        const target = event.target instanceof Element ? event.target : null;
        const hidden =
          target !== null &&
          (target.closest(CLICKABLE) !== null || zones.some((zone) => zone.contains(target)));

        trail.dataset.active = String(!hidden);
        if (hidden) stop();
        else start();
      },
      { passive: true },
    );

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
    });
  }
</script>

<style>
  .trail {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: none;
    pointer-events: none;
  }

  .trail[data-active='true'] {
    display: block;
  }

  .trail__dot {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--size);
    height: var(--size);
    margin: calc(var(--size) / -2);
    border-radius: 50%;
    background-color: var(--color-signal);
    opacity: var(--fade);
    will-change: transform;
  }

  @media (width < 64rem) {
    .trail {
      display: none;
    }
  }

  @media (pointer: coarse) {
    .trail {
      display: none;
    }
  }
</style>