---
import Container from '@/components/Container.astro';
import Wordmark from '@/components/Wordmark.astro';
import { NAV_LINKS } from '@/consts';
---

<header class="header">
  <Container class="flex items-center justify-between gap-6 py-4">
    <a
      href="/"
      class="link-slide font-display text-lg font-bold tracking-tight text-ink"
    >
      <Wordmark />
    </a>

    <nav aria-label="Primary">
      <button
        type="button"
        class="nav__burger"
        aria-expanded="false"
        aria-controls="primary-nav"
        aria-label="Open menu"
      >
        <span class="nav__bar"></span>
        <span class="nav__bar"></span>
        <span class="nav__bar"></span>
      </button>

      <div id="primary-nav" class="nav__panel">
        <ul class="nav__list">
          {
            NAV_LINKS.map(({ href, label }) => (
              <li>
                <a href={href} class="link-slide label text-ink-muted">
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>
  </Container>
</header>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.nav__burger');
  const list = document.getElementById('primary-nav');

  if (burger && list) {
    const setOpen = (open: boolean): void => {
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      list.dataset.open = String(open);
    };

    burger.addEventListener('click', () => {
      setOpen(burger.getAttribute('aria-expanded') !== 'true');
    });

    // Anchors do not navigate away, so the panel has to be closed explicitly.
    list.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  }
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    inset-inline: 0;
    z-index: 50;
    border-bottom: 1px solid var(--color-surface-muted);
    background-color: color-mix(in srgb, var(--color-surface) 85%, transparent);
    backdrop-filter: blur(12px);
  }

  @media (width >= 40rem) {
    @supports (animation-timeline: view()) {
      .header {
        animation: header-reveal linear both;
        animation-timeline: --hero;
        animation-range: exit 85% exit 100%;
      }
    }
  }

  @keyframes header-reveal {
    from {
      opacity: 0;
      transform: translateY(-100%);
      pointer-events: none;
    }
    to {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header {
      animation: none;
    }
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav__burger {
    display: none;
  }

  @media (width < 40rem) {
    .nav__burger {
      display: grid;
      gap: 5px;
      padding: 0.35rem;
      cursor: pointer;
      background: none;
      border: 0;
    }

    .nav__bar {
      display: block;
      width: 22px;
      height: 2px;
      background-color: var(--color-ink);
      transition: transform 0.2s var(--ease-out-quint), opacity 0.2s linear;
    }

    .nav__burger[aria-expanded='true'] .nav__bar:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .nav__burger[aria-expanded='true'] .nav__bar:nth-child(2) {
      opacity: 0;
    }

    .nav__burger[aria-expanded='true'] .nav__bar:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

        /* display cannot be transitioned, so the panel folds on grid-template-rows
         instead, 0fr to 1fr animates to content height without measuring it. */
      .nav__panel {
        position: absolute;
        inset: 100% 0 auto 0;
        display: grid;
        grid-template-rows: 0fr;
        background-color: var(--color-surface);
        transition: grid-template-rows 0.34s var(--ease-out-quint);
      }

      .nav__panel[data-open='true'] {
        grid-template-rows: 1fr;
        border-bottom: 1px solid var(--color-surface-muted);
      }

      /* Hidden rather than merely clipped: a collapsed panel would otherwise
         keep its links in the tab order. Held until the fold finishes. */
      .nav__list {
        flex-direction: column;
        align-items: flex-start;
        gap: 0;
        overflow: hidden;

        /* Perspective belongs on the items' direct parent: overflow forces
           transform-style flat, so a preserve-3d chain from the panel breaks. */
        perspective: 900px;
        visibility: hidden;
        transition: visibility 0s linear 0.42s;
      }

      .nav__panel[data-open='true'] .nav__list {
        visibility: visible;
        transition-delay: 0s;
      }

      .nav__list li {
        width: 100%;
        border-top: 1px solid var(--color-surface-muted);
        opacity: 0;
        transform-origin: top center;
        transform: rotateX(-88deg);
        backface-visibility: hidden;
        transition:
          opacity 0.2s linear,
          transform 0.44s var(--ease-out-quint);
      }

      .nav__panel[data-open='true'] li {
        opacity: 1;
        transform: rotateX(0deg);
      }

      /* Opening runs top to bottom; the closed-state delays reverse it, so the
         panel folds shut from the bottom up instead of all at once. */
      .nav__list li:nth-child(1) {
        transition-delay: 0.09s;
      }
      .nav__list li:nth-child(2) {
        transition-delay: 0.06s;
      }
      .nav__list li:nth-child(3) {
        transition-delay: 0.03s;
      }
      .nav__list li:nth-child(4) {
        transition-delay: 0s;
      }

      .nav__panel[data-open='true'] li:nth-child(1) {
        transition-delay: 0.05s;
      }
      .nav__panel[data-open='true'] li:nth-child(2) {
        transition-delay: 0.1s;
      }
      .nav__panel[data-open='true'] li:nth-child(3) {
        transition-delay: 0.15s;
      }
      .nav__panel[data-open='true'] li:nth-child(4) {
        transition-delay: 0.2s;
      }

      .nav__list a {
        display: block;
        padding: 1rem 1.5rem;
      }
  }
</style>
