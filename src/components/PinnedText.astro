---
import Container from '@/components/Container.astro';

interface Props {
  id: string;
  label: string;
}

const { id, label }: Props = Astro.props;
---

<section class="pin" aria-labelledby={`${id}-label`}>
  <div class="pin__stage">
    <Container>
      <h2 id={`${id}-label`} class="label">
        {label}
      </h2>
      <div class="pin__body">
        <slot />
      </div>
    </Container>
  </div>

  <span id={id} class="pin__anchor" aria-hidden="true"></span>
</section>

<style>
  .pin {
    position: relative;
    height: 380vh;
    border-top: 1px solid var(--color-surface-muted);
    view-timeline: --exp block;
  }

  @media (width < 40rem) {
    .pin {
      height: 300vh;
    }
  }

  .pin__stage {
    position: sticky;
    top: 0;
    display: grid;
    align-content: center;
    min-height: 100dvh;
    overflow: clip;
    contain: paint;
    padding-block: var(--section-space);
  }

  .pin__anchor {
    position: absolute;
    top: calc(100% - 102vh);
    width: 1px;
    height: 1px;
  }

  .pin__body {
    display: grid;
    gap: 1.75rem;
    margin-top: 2.5rem;
  }
</style>
