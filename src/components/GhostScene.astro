<div class="ghost">
  <canvas class="ghost__canvas" data-ghost-canvas aria-hidden="true"></canvas>
</div>

<script>
  import { canRenderScene, onceVisible } from '@/scripts/lazy';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-ghost-canvas]');

  // The figure follows the pointer, so there is nothing to see on touch.
  if (canvas && canRenderScene() && matchMedia('(pointer: fine)').matches) {
    onceVisible(
      canvas,
      () => {
        import('@/scripts/ghost-scene').then(({ initGhostScene }) => {
          initGhostScene(canvas);
        });
      },
      { rootMargin: '300px' },
    );
  }
</script>

<style>
  .ghost {
    display: none;
  }

  @media (width >= 64rem) {
    .ghost {
      display: block;
      aspect-ratio: 1;
      width: 100%;
      max-width: 22rem;
      margin-inline: auto;
    }
  }

  .ghost__canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
