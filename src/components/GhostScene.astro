---

<div class="ghost">
  <canvas class="ghost__canvas" data-ghost-canvas aria-hidden="true"></canvas>
</div>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-ghost-canvas]');
  const nav = navigator as Navigator & { deviceMemory?: number };

  /* Mirrors the media query that hides .ghost below 64rem — without the width
     check the scene would download for a canvas nobody can see. */
  const wanted =
    !matchMedia('(prefers-reduced-motion: reduce)').matches &&
    matchMedia('(width >= 64rem)').matches &&
    matchMedia('(pointer: fine)').matches;

  const capable = (nav.deviceMemory ?? 8) >= 4 && (nav.hardwareConcurrency ?? 8) >= 4;

  if (canvas && wanted && capable) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        import('@/scripts/ghost-scene').then(({ initGhostScene }) => {
          initGhostScene(canvas);
        });
      },
      { rootMargin: '300px' },
    );
    observer.observe(canvas);
  }
</script>

<style>
  .ghost {
    display: none;
  }

  @media (width >= 64rem) {
    .ghost {
      display: block;
      aspect-ratio: 1;
      width: 100%;
      max-width: 22rem;
      margin-inline: auto;
    }
  }

  .ghost__canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
