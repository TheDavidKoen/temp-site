{
  "name": "davidkoen-site",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc -p functions/tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "budget": "node scripts/check-budget.mjs",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run build && pnpm run budget"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/workers-types": "^5.20260920.1",
    "@lhci/cli": "^0.15.1",
    "@types/three": "^0.186.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.135.0"
  }
}
